# ─── Client (public) ────────────────────────────────────────────────────────
# Anything prefixed VITE_ is inlined into the browser bundle. No secrets here.
VITE_SANITY_PROJECT_ID=khsof0do
VITE_SANITY_DATASET=production

# ─── Server only (secret) ───────────────────────────────────────────────────
# Set these in the Vercel dashboard. Locally they go in .env.local, which is
# gitignored. They are read by the /api functions via process.env.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=mvmories@gmail.com

# Must be a Resend-verified domain. Falls back to Resend's shared sandbox
# sender, which can only deliver to your own Resend account address.
CONTACT_FROM_EMAIL="Miguel Vilhena <hello@miguelvilhena.com>"

# Used in email footers and canonical links.
SITE_URL=https://miguelvilhena.com

# Optional: audit copy of each submission in Sanity. Needs Editor rights.
SANITY_PROJECT_ID=khsof0do
SANITY_DATASET=production
SANITY_WRITE_TOKEN=

# Optional: loosen the rate limiter while testing locally.
# CONTACT_RATE_LIMIT_MAX=100
