{
  "name": "frontend_react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "email:preview": "vitest run emails && open .email-previews/notification.html .email-previews/auto-reply.html",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@sanity/client": "^6.29.1",
    "@sanity/image-url": "^1.2.0",
    "@tippyjs/react": "^4.2.6",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "resend": "^6.18.1",
    "tippy.js": "^6.3.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@netlify/functions": "^5.3.0",
    "@netlify/vite-plugin": "^2.12.9",
    "@react-email/render": "^2.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.100.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.27.0": true,
    "esbuild@0.27.7": true
  }
}
